# ==============================================================================
# ASSISTENTE ACADÊMICO AUTÔNOMO - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# Chave Oficial da API Gemini (Google AI Studio)
GEMINI_API_KEY="AIzaSyYourApiKeyHere"

# Caminhos das Credenciais do Google Workspace (Classroom, Drive, Calendar)
GOOGLE_CREDENTIALS_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"

# Banco de Dados Relacional SQLite
DATABASE_URL="sqlite:///./data/academic_assistant.db"

# Parâmetros do Protocolo ntfy
NTFY_SERVER_URL="https://ntfy.sh"
NTFY_TOPIC="assistente_academico_dev"
PUBLIC_API_BASE_URL="http://localhost:8000"

# Fuso Horário Canônico
TIMEZONE="America/Sao_Paulo"
